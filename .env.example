# 必填：Anthropic 官方或兼容 Anthropic Messages API 的模型服务
ANTHROPIC_API_KEY=replace_with_your_key
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 基础设施
REDIS_PASSWORD=coordexa_dev_password
COORDEXA_FRONTEND_PORT=8080
COORDEXA_BACKEND_PORT=8200
COORDEXA_PROMETHEUS_PORT=9190
MONITOR_INTERVAL=10
LOG_LEVEL=INFO

# 可选
ALERT_WEBHOOK_URL=
COORDEXA_SKILLS_MAX_PROMPT_CHARS=5000

# v1.1 可观测性与上下文实验参数（不填写价格时只记录真实 usage，不估算成本）
COORDEXA_INPUT_COST_PER_1M=
COORDEXA_OUTPUT_COST_PER_1M=
COORDEXA_CONTEXT_LIMIT_CHARS=24000
COORDEXA_CONTEXT_RESERVED_OUTPUT_CHARS=6000
COORDEXA_CONTEXT_PROMPT_CHARS=5000
COORDEXA_CONTEXT_MEMORY_CHARS=6000
COORDEXA_CONTEXT_RETRIEVAL_CHARS=7000
COORDEXA_CHUNK_SIZE=500
COORDEXA_CHUNK_OVERLAP=0
COORDEXA_CHUNK_HARD_SPLIT=true
COORDEXA_COMPOSER_MAX_TOKENS=1000
COORDEXA_COMPOSER_TEMPERATURE=0.1
COORDEXA_TOOL_TRACE_MAX=200
